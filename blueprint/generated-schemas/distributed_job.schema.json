{
  "additionalProperties": false,
  "properties": {
    "script": {
      "description": "Absolute path to the shell script",
      "title": "Script",
      "type": "string"
    },
    "host_group": {
      "default": "unix-batch",
      "description": "Control-M host group",
      "title": "Host Group",
      "type": "string"
    },
    "blueprint": {
      "type": "string",
      "const": "distributed_job",
      "description": "The blueprint template to use"
    },
    "version": {
      "type": "integer",
      "const": 1,
      "description": "The blueprint version"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Steps that must complete before this step runs",
      "default": []
    },
    "trigger_rule": {
      "type": "string",
      "enum": [
        "all_done",
        "all_done_min_one_success",
        "all_done_setup_success",
        "all_failed",
        "all_skipped",
        "all_success",
        "always",
        "none_failed",
        "none_failed_min_one_success",
        "none_skipped",
        "one_done",
        "one_failed",
        "one_success"
      ],
      "description": "Trigger rule for this step (default: all_success)"
    }
  },
  "required": [
    "blueprint",
    "version",
    "script"
  ],
  "title": "distributed_job",
  "type": "object",
  "templateType": "blueprint",
  "$schema": "http://json-schema.org/draft-07/schema#"
}