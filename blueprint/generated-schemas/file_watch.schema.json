{
  "additionalProperties": false,
  "properties": {
    "path": {
      "description": "Path or glob to watch",
      "title": "Path",
      "type": "string"
    },
    "poke_seconds": {
      "default": 30,
      "minimum": 5,
      "title": "Poke Seconds",
      "type": "integer"
    },
    "timeout_minutes": {
      "default": 60,
      "minimum": 1,
      "title": "Timeout Minutes",
      "type": "integer"
    },
    "blueprint": {
      "type": "string",
      "const": "file_watch",
      "description": "The blueprint template to use"
    },
    "version": {
      "type": "integer",
      "const": 1,
      "description": "The blueprint version"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Steps that must complete before this step runs",
      "default": []
    },
    "trigger_rule": {
      "type": "string",
      "enum": [
        "all_done",
        "all_done_min_one_success",
        "all_done_setup_success",
        "all_failed",
        "all_skipped",
        "all_success",
        "always",
        "none_failed",
        "none_failed_min_one_success",
        "none_skipped",
        "one_done",
        "one_failed",
        "one_success"
      ],
      "description": "Trigger rule for this step (default: all_success)"
    }
  },
  "required": [
    "blueprint",
    "version",
    "path"
  ],
  "title": "file_watch",
  "type": "object",
  "templateType": "blueprint",
  "$schema": "http://json-schema.org/draft-07/schema#"
}