{
  "additionalProperties": false,
  "properties": {
    "jcl_member": {
      "description": "JCL member name (e.g. LNSVC010)",
      "title": "Jcl Member",
      "type": "string"
    },
    "lpar": {
      "default": "PROD1",
      "description": "Target LPAR",
      "enum": [
        "PROD1",
        "PROD2",
        "DR"
      ],
      "title": "Lpar",
      "type": "string"
    },
    "max_rc": {
      "default": 4,
      "description": "Highest acceptable RC",
      "maximum": 16,
      "minimum": 0,
      "title": "Max Rc",
      "type": "integer"
    },
    "blueprint": {
      "type": "string",
      "const": "mainframe_job",
      "description": "The blueprint template to use"
    },
    "version": {
      "type": "integer",
      "const": 1,
      "description": "The blueprint version"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Steps that must complete before this step runs",
      "default": []
    },
    "trigger_rule": {
      "type": "string",
      "enum": [
        "all_done",
        "all_done_min_one_success",
        "all_done_setup_success",
        "all_failed",
        "all_skipped",
        "all_success",
        "always",
        "none_failed",
        "none_failed_min_one_success",
        "none_skipped",
        "one_done",
        "one_failed",
        "one_success"
      ],
      "description": "Trigger rule for this step (default: all_success)"
    }
  },
  "required": [
    "blueprint",
    "version",
    "jcl_member"
  ],
  "title": "mainframe_job",
  "type": "object",
  "templateType": "blueprint",
  "$schema": "http://json-schema.org/draft-07/schema#"
}