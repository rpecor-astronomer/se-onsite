{
  "additionalProperties": false,
  "properties": {
    "report_code": {
      "description": "Regulatory report identifier",
      "enum": [
        "CALL",
        "SOX-404",
        "FFIEC-031",
        "FR-Y-9C"
      ],
      "title": "Report Code",
      "type": "string"
    },
    "prepared_by": {
      "default": "regops",
      "description": "Preparer team",
      "title": "Prepared By",
      "type": "string"
    },
    "approval_timeout_minutes": {
      "default": 45,
      "minimum": 1,
      "title": "Approval Timeout Minutes",
      "type": "integer"
    },
    "blueprint": {
      "type": "string",
      "const": "regulatory_report",
      "description": "The blueprint template to use"
    },
    "version": {
      "type": "integer",
      "const": 1,
      "description": "The blueprint version"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Steps that must complete before this step runs",
      "default": []
    },
    "trigger_rule": {
      "type": "string",
      "enum": [
        "all_done",
        "all_done_min_one_success",
        "all_done_setup_success",
        "all_failed",
        "all_skipped",
        "all_success",
        "always",
        "none_failed",
        "none_failed_min_one_success",
        "none_skipped",
        "one_done",
        "one_failed",
        "one_success"
      ],
      "description": "Trigger rule for this step (default: all_success)"
    }
  },
  "required": [
    "blueprint",
    "version",
    "report_code"
  ],
  "title": "regulatory_report",
  "type": "object",
  "templateType": "blueprint",
  "$schema": "http://json-schema.org/draft-07/schema#"
}